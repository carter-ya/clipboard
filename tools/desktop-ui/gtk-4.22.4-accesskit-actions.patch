+        g_printerr ("clipboard-a11y: flush pending tree update\n");
+      gtk_accesskit_root_update_tree (pending->root);
+    }
+  return G_SOURCE_REMOVE;
+}
+
+static void
+free_pending_tree_update (gpointer data)
+{
+  PendingTreeUpdate *pending = data;
+  g_object_unref (pending->widget);
+  g_object_unref (pending->root);
+  g_free (pending);
